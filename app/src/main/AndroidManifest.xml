<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Required on Android 13+ (API 33) to post the transaction-captured
         notification with its Split/Add Note/Undo actions. Requested at
         runtime; the app functions normally if the user declines it, just
         without this convenience. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- RC5: required for the AI infrastructure's provider calls (feature/ai/provider).
         Ledger remains fully functional offline — nothing here is called unless the
         user explicitly enables AI in Settings and configures a provider; see
         AiSettingsRepository.isAiEnabled (defaults false) and AIOrchestrator, which
         checks it before doing anything else. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- feature/update: installing a downloaded GitHub-release APK requires
         this on Android 8+. Requested by redirecting to
         Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES only when the user taps
         "Update" and it isn't already granted (see UpdateDialog) — never
         requested unprompted. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".LedgerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ledger">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ledger">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".feature.capture.sms.SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".feature.capture.notification.LedgerNotificationListener"
            android:exported="true"
            android:label="Ledger Notification Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".feature.notification.UndoTransactionReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".feature.notification.AddNoteReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Shares the generated diagnostic bundle (a zip in cacheDir/diagnostics)
             with whatever app the user picks — Android requires this for any
             file:// content shared across apps since API 24. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnosticfileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>





