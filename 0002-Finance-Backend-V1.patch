+            accountId = 2,
+            brandId = 3,
+            categoryId = 4,
+            amountMinor = 1500,
+            currencyCode = CurrencyCode.AED,
+            type = TransactionType.EXPENSE,
+            timestampEpochMillis = 1719878400000L, // 2024-07-02
